BOT_TOKEN=123456789:AA...replace_me
ADMIN_IDS=8927983640
ADMIN_PASSWORD=change_this_password
PANEL_SECRET=change_this_long_random_string
PANEL_HOST=127.0.0.1
PANEL_PORT=8080
BOT_USERNAME=
PUBLIC_PANEL_URL=http://127.0.0.1:8080

# SQLite for local start. PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://ural:ural@127.0.0.1:5432/ural_team
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

TON_API_BASE=https://tonapi.io
TON_API_KEY=
TONCENTER_URL=https://toncenter.com/api/v2
TONCENTER_API_KEY=
GETGEMS_API=https://api.getgems.io/graphql

# Forum group / topics (negative chat id, topic thread id)
MONITOR_CHAT_ID=0
MONITOR_TOPIC_ID=0
DEALS_CHAT_ID=0
DEALS_TOPIC_ID=0
PAYOUTS_CHAT_ID=0
PAYOUTS_TOPIC_ID=0

# Пароль для приёма сделок из бота GG Sel (тот же в его PANEL_API_SECRET).
MARKETPLACE_SECRET=change_me
# Порт HTTP-приёма сделок. На Bothost переменную PORT подставляет сам хостинг,
# локально можно задать вручную: PORT=8081
# PORT=8081
DEFAULT_PAYOUT_RATE=70

# 24 слова из Tonkeeper (предпочтительно через бота: Админ → Кошелёк выплат).
# 12 слов — Telegram Wallet. Отдельный кошелёк только для выплат, не основной.
# TON_WALLET_VERSION=auto  — сам выберет v4r2 / W5 / Wallet
# TON_WALLET_VERSION=v4r2 — принудительно Tonkeeper (Wallet v4)
TON_WALLET_MNEMONIC=
TON_WALLET_VERSION=auto
TON_AUTO_WITHDRAW=true
